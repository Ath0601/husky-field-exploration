<?xml version="1.0" ?>
<sdf version="1.8">

  <world name="fieldrobo_world">

    <!-- ========================================================= -->
    <!-- PHYSICS                                                    -->
    <!-- ========================================================= -->

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <!-- ========================================================= -->
    <!-- LIGHTING                                                   -->
    <!-- ========================================================= -->

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 -0.4 -1</direction>
    </light>


    <!-- ========================================================= -->
    <!-- GROUND                                                      -->
    <!-- 30 m x 26 m                                                 -->
    <!-- ========================================================= -->

    <model name="ground">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>30 26 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>30 26 0.1</size>
            </box>
          </geometry>
          <pose>0 0 -0.05 0 0 0</pose>

          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- ========================================================= -->
    <!-- Required Gazebo Fortress system plugins                  -->
    <!-- ========================================================= -->

    <plugin filename="libignition-gazebo-user-commands-system.so"
        name="ignition::gazebo::systems::UserCommands"/>
    
    <!-- Physics -->
    <plugin
      filename="libignition-gazebo-physics-system.so"
      name="ignition::gazebo::systems::Physics">
    </plugin>

    <!-- Scene / GUI -->
    <plugin
      filename="libignition-gazebo-scene-broadcaster-system.so"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <!-- Sensors: required for GPU LiDAR -->
    <plugin
      filename="libignition-gazebo-sensors-system.so"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- IMU -->
    <plugin
      filename="libignition-gazebo-imu-system.so"
      name="ignition::gazebo::systems::Imu">
    </plugin>


    <!-- ========================================================= -->
    <!-- OUTER WALLS                                                 -->
    <!-- ========================================================= -->

    <!-- North -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 13 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>30 0.25 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>30 0.25 2</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- South -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -13 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>30 0.25 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>30 0.25 2</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- West -->
    <model name="wall_west">
      <static>true</static>
      <pose>-15 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.25 26 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.25 26 2</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- East -->
    <model name="wall_east">
      <static>true</static>
      <pose>15 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.25 26 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.25 26 2</size></box>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ========================================================= -->
    <!-- SIMPLE EXPLORATION OBSTACLES                              -->
    <!-- Large open free space is intentional so Nav2 can plan    -->
    <!-- between frontiers without getting trapped by narrow      -->
    <!-- corridors or dead ends.                                  -->
    <!-- ========================================================= -->

    <model name="obstacle_1">
      <static>true</static>
      <pose>-6 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>4 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_3">
      <static>true</static>
      <pose>7 -5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_4">
      <static>true</static>
      <pose>-5 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </visual>
      </link>
    </model>

  
    <model name="obstacle_5">
      <static>true</static>
      <pose>-10 -8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 1.5 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.5 1.2</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_6">
      <static>true</static>
      <pose>-2 -8 0.5 0 0 0.35</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 2.0 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 2.0 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_7">
      <static>true</static>
      <pose>10 7 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 2.0 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 2.0 1.2</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_8">
      <static>true</static>
      <pose>7 1 0.5 0 0 0.6</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </visual>
      </link>
    </model>


    <model name="obstacle_9">
      <static>true</static>
      <pose>-10 3 0.5 0 0 0.25</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 1.4 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 1.4 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="obstacle_10">
      <static>true</static>
      <pose>-1.5 7.5 0.6 0 0 0.5</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 1.4 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 1.4 1.2</size></box></geometry></visual>
      </link>
    </model>
    <model name="obstacle_11">
      <static>true</static>
      <pose>2.5 -5.0 0.5 0 0 0.2</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 1.8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 1.8 1.0</size></box></geometry></visual>
      </link>
    </model>
    <model name="obstacle_12">
      <static>true</static>
      <pose>11 -2.5 0.6 0 0 0.7</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 1.6 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 1.6 1.2</size></box></geometry></visual>
      </link>
    </model>

  </world>
</sdf>